# 唯一的配置模板：应用（app/core/config.py）与 docker compose 都读这一个文件。
#   用法：cp .env.example .env  然后填密码。.env 已被 .gitignore 忽略，不要提交。
#   字段名即 app/core/config.py 里的配置项名；compose 侧的 MYSQL_USER /
#   MYSQL_PASSWORD 由 DB_USER / DB_PASSWORD 映射而来，不需要第二套变量。

PROJECT_NAME=learn-fastapi
VERSION=0.1.0
DEBUG=true

# ---- 日志 ----
# 必须显式配置：root logger 默认 WARNING 且没有 handler，
# 不配的话项目里所有 logger.info 都会被静默丢掉
LOG_LEVEL=INFO
# json = 一行一个 JSON（生产）；text = 本地肉眼可读
LOG_FORMAT=text

# ---- 指标 ----
# /metrics（Prometheus 文本格式）暴露在根路径，靠内网 / 反向代理限制来源
METRICS_ENABLED=true

HOST=127.0.0.1
PORT=8000

# 复杂类型（List）用 JSON 写法
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- SSE ----
# ping 注释间隔（秒），需小于网关/负载均衡的空闲超时（常见 60s）
SSE_PING_SECONDS=15
# 断线续传：生成结束后，Redis 里的分片缓冲保留多久（秒）。过期后续传返回 410
SSE_RESUME_TTL_SECONDS=600
# 断线续传：所有客户端都断开多久之后停止生成（秒）。续传要求生成活过连接，
# 所以不能断线就停；但一直开着就是白烧 token，这个值就是放弃的界线
SSE_RESUME_GRACE_SECONDS=30

# ---- LLM（LangChain，OpenAI 兼容网关）----
# 不配置密钥 = 功能关闭：服务照常启动，/api/v1/chat/* 返回 503
LLM_API_KEY=
# 留空走 OpenAI 官方；填自建/第三方网关，如 https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7
# 单次回答的输出上限。不设 = 把账单控制权交给模型；0 表示不限制（不推荐）
LLM_MAX_TOKENS=2048
# 每轮对话喂给模型的历史条数（从数据库按会话加载）。这是**兜底**，
# 真正控成本的是下面那个 token 预算：单条消息上限 8000 字符，
# 20 条最坏就是 4 万 token。
CHAT_CONTEXT_MESSAGES=20
# 历史上下文的总 token 预算（不含本轮提问）。超出就从最旧的开始丢。
CHAT_CONTEXT_MAX_TOKENS=3000

# ---- 对话成本闸门 ----
# 只校验 JWT 挡不住账单：一个账号可以无限并发、无限长输出。
# 每人每分钟最多几轮对话
CHAT_RATE_LIMIT_PER_MINUTE=10
# 每人同时在途的生成数（流式与非流式都算）
CHAT_MAX_CONCURRENT_STREAMS=2
# 单条流占用名额的最长时间（秒）：进程崩溃时名额靠它自然回收
CHAT_INFLIGHT_TTL_SECONDS=900
# 每人每日 token 预算（输入 + 输出），0 = 不限制。
# 它是防跑飞的护栏，不是计费依据 —— 精确账单看 messages 表里的用量
CHAT_DAILY_TOKEN_BUDGET=200000

# ---- 提示词 ----
# 正文在仓库根的 prompts/*.md（不在 app/ 包里），这里只选"用哪个"。
# 切换提示词变体（灰度/租户）改这一项即可，不必改代码。
PROMPT_CHAT_SYSTEM_ID=chat_system
# 提示词目录。相对路径按仓库根解析；容器里挂到别处就填绝对路径（如 /app/prompts）。
PROMPTS_DIR=prompts

# ---- 雪花 ID ----
# 机器号 0-1023。单实例填 0；多实例部署时每台必须不同，否则会生成相同 ID。
SNOWFLAKE_WORKER_ID=0

# ---- 数据库 ----
# 运行时账号：已被收权成只有 SELECT/INSERT/UPDATE/DELETE（见 deploy/mysql/initdb）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app
DB_PASSWORD=
DB_NAME=agent_chat
DB_ECHO=false

# MySQL root 密码：只给 compose 初始化数据目录用，应用不读这一项。
# 生产请用 openssl rand -base64 24 之类生成，不要用示例值。
MYSQL_ROOT_PASSWORD=

# 迁移账号：只有它拥有 DDL，alembic 用这个。
# 不配会退回运行时账号 —— 那种情况下 app 账号必然带着 DDL 权限，生产别这么干。
DB_MIGRATION_USER=migrator
DB_MIGRATION_PASSWORD=

# ---- Redis（验证码 / 限流）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 鉴权 ----
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空 = 鉴权功能关闭（/api/v1/auth/* 返回 503），其余接口不受影响。
# 换掉密钥后已签发的 access token 全部失效，属于预期行为。
JWT_SECRET=
# access 短、refresh 长。access 不落库，泄露后最多被用这么久。
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# 登录失败限流：按账号防定点爆破，按 IP 防一台机器换账号刷。
# 必须在验密之前拦 —— argon2 单次约 50ms CPU，不挡就是免认证的 CPU 放大器。
# 窗口内成功登录只清账号计数，不清 IP 计数（否则有任意有效账号即可绕过）。
LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_FAILURE_WINDOW_SECONDS=900

# ---- 邮件（QQ / 163 / 任意标准 SMTP）----
# SMTP_PASSWORD 填**授权码**，不是邮箱登录密码。
# QQ 邮箱：设置 → 账户 → POP3/SMTP 服务 → 生成授权码
# 465 = 隐式 SSL，587 = STARTTLS，按端口自动判定
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=AI 助手
SMTP_TIMEOUT_SECONDS=10

# ---- 邮箱验证码 ----
# TTL 是"码多久失效"，RESEND 是"多久能再要一个"，两者不是一回事
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_CODE_RESEND_SECONDS=60
# 同一个码允许试错几次。6 位数字在有效期内不限次是能被穷举的。
VERIFICATION_CODE_MAX_ATTEMPTS=5
# 两层配额：按邮箱防单点轰炸，按 IP 防换邮箱刷
VERIFICATION_DAILY_LIMIT_PER_EMAIL=10
VERIFICATION_HOURLY_LIMIT_PER_IP=20

# ---- 人机验证（VAPTCHA V4）----
# VID / VKey 来自 VAPTCHA 控制台的验证单元，两者任一留空 = 关闭。
# VKey 只能放服务端，绝不进前端代码。
VAPTCHA_VID=
VAPTCHA_VKEY=
# remote = 调官方接口（默认）；local = 本地 HMAC-SHA256 校验 + Redis 一次性防重放
VAPTCHA_VERIFY_MODE=remote
VAPTCHA_VERIFY_URL=https://v41.vaptcha.com/api/verify
VAPTCHA_TIMEOUT_SECONDS=5
# 仅 local 模式：票据有效期（秒）
VAPTCHA_LOCAL_TTL_SECONDS=3
# 官方返回 data.code=1（IP 漂移）时是否放行；默认严格拒绝
VAPTCHA_ALLOW_CODE_1=false
